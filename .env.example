# Create a Firebase Web App in project "fun-ground" and copy its config values here.
# Add these same NEXT_PUBLIC_ variables in Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fun-ground.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fun-ground
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account JSON (never prefix with NEXT_PUBLIC_).
# Store the full service-account JSON as a Vercel encrypted environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Competitive systems remain disabled unless explicitly enabled server-side.
FUN_GROUND_ACTIVITY_TRACKING_ENABLED=false
# Optional client hint only; the server-side gate above remains authoritative.
NEXT_PUBLIC_FG_ACTIVITY_TRACKING_ENABLED=false
# Generic multiplayer matchmaking for games with an explicitly approved integration.
FUN_GROUND_MATCHMAKING_ENABLED=false
# Fun Ground Chess online API gate. Keep false until multiplayer lifecycle testing is complete.
FUN_GROUND_CHESS_ONLINE_MATCHES_ENABLED=false
# Client-only visibility gate; enable only alongside the server gate in a controlled test.
NEXT_PUBLIC_CHESS_ONLINE_UI_ENABLED=false
FUN_GROUND_RANKED_ENABLED=false
FUN_GROUND_DAILY_MISSIONS_ENABLED=false
FUN_GROUND_LEADERBOARDS_ENABLED=false
FUN_GROUND_TOURNAMENT_ENTRY_ENABLED=false
FUN_GROUND_REWARDS_LEDGER_ENABLED=false
